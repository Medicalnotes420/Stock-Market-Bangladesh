{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chartapp",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "chartapp.api:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "watch-report",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "data/watch"],
      "port": 8765
    }
  ]
}
