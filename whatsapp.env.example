# Copy this file to whatsapp.env (same folder) and fill in your own values. Never share or commit whatsapp.env.
# From Meta's WhatsApp > API Setup page:
WA_TOKEN=
WA_PHONE_ID=
# From Meta's App settings > Basic > App secret:
WA_APP_SECRET=
# Any made-up password; type the same one into Meta's webhook form:
WA_VERIFY_TOKEN=
# Your own WhatsApp number with country code, digits only (e.g. 8801XXXXXXXXX). Only these numbers get replies; separate several with commas.
WA_ALLOWED=
# From console.anthropic.com > API keys (paid per message):
ANTHROPIC_API_KEY=
WA_PORT=8080
